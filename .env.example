# =============================================================================
# APPLICATION HOSTING (Vite in Express Middleware)
# =============================================================================
PORT=3000
APP_URL="http://localhost:3000"

# =============================================================================
# SUPABASE CONFIGURATION (POSTGRESQL & PRIVATE OBJECT STORAGE)
# =============================================================================
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
SUPABASE_SECRET_KEY="your-supabase-secret-key" # Server-only (keep private!)
SUPABASE_JWKS_URL="https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json"

# =============================================================================
# GEMINI AGRICULTURAL AI INTELLIGENCE
# =============================================================================
# Gemini API Key for multimodal disease diagnosis, label OCR, and voice synthesis
GEMINI_API_KEY="your-gemini-api-key"

# =============================================================================
# OPTIONAL SERVICES
# =============================================================================
OPENWEATHER_API_KEY="your-openweather-api-key"
